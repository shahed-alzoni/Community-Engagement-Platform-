DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=qarib_db
DB_USER=qarib_user
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Gmail SMTP. Create an App Password and place it only in your local .env file.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=qaribsupport@gmail.com
EMAIL_HOST_PASSWORD=replace-with-your-16-character-gmail-app-password
DEFAULT_FROM_EMAIL=Qarib Support <qaribsupport@gmail.com>

# Public frontend address used in password-reset email links.
FRONTEND_BASE_URL=http://localhost:5173
